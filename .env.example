# Bloom — API Keys Configuration
# Rename this file to .env and fill in your keys.

# OpenAI API Key (for Cinematic Narration)
# Get one at: https://platform.openai.com/
VITE_OPENAI_API_KEY=

# Google Gemini API Key (Alternative for Cinematic Narration)
# Get one at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Unsplash Access Key (for City Background Images)
# Get one at: https://unsplash.com/developers
VITE_UNSPLASH_ACCESS_KEY=

# OpenAQ API Key (for Air Quality Data)
# Get one at: https://docs.openaq.org/
VITE_OPENAQ_API_KEY=
